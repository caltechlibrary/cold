#
# cold.env the runtime environment for the cold middle ware service and datasetd using cold_api.yaml 
# under systemd.
#
# Put any environment settings here.
#


#
# The COLD/RDM people sync (cold#122, DR-0033, DR-0035). These keys go in the
# env file the sync is given (caltechauthors.env, the same file the RDM
# harvests use), not in this service environment. No real value is committed.
#
#   PEOPLE_SYNC_TRANSPORT  ssh (default; production, from apps) or ssm (the development
#                        instance, reachable only through AWS Systems Manager)
#   RDM_HOST             ssh host of the RDM instance (required for ssh)
#   RDM_INSTANCE_ID      EC2 instance id, i-... (required for ssm); the machine running
#                        the sync needs the aws CLI and credentials that may
#                        ssm:SendCommand to that instance only
#   AWS_REGION, AWS_PROFILE  optional, passed to the aws CLI (ssm only)
#   RDM_URL              public URL of that instance (required); the sync refuses
#                        to run without it, and every run records it
#   RDM_CHECKOUT         the RDM checkout on that host (default /Sites/caltechauthors)
#   RDM_RUN_USER         the user the program runs as, via sudo (default ubuntu)
#   IRDMTOOLS_SCRIPTS    the irdmtools scripts directory (default ../irdmtools/scripts,
#                        a sibling of COLD: /Sites/irdmtools beside /Sites/cold)
#   PEOPLE_SYNC_MODE     dry-run (the default) or apply. Only apply writes to RDM.
#   PEOPLE_SYNC_STALE_SECONDS  age after which a held lock is taken over (360;
#                        to be set from a measured full run)
#   COLD_API_URL         COLD's datasetd (default http://localhost:8112)
#
# Development, authors.caltechlibrary.dev:
#   RDM_URL=https://authors.caltechlibrary.dev
# Production, authors.library.caltech.edu:
#   RDM_URL=https://authors.library.caltech.edu
